{
  "name": "@shuji-bonji/rfcxml-mcp",
  "version": "0.6.25",
  "description": "MCP server for structured understanding of RFC documents via RFCXML",
  "keywords": [
    "mcp",
    "rfc",
    "rfcxml",
    "ietf",
    "protocol",
    "specification"
  ],
  "author": "shuji-bonji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuji-bonji/rfcxml-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rfcxml-mcp": "dist/index.js",
    "rfcxml-prefetch": "dist/cli/prefetch.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/cli/prefetch.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prefetch": "node dist/cli/prefetch.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "node tests/e2e/mcp-client-test.mjs",
    "audit": "node tests/audit/run.mjs",
    "snapshot": "node tests/snapshot/run.mjs",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
