{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.claude-plugin/plugin.schema.json",
  "name": "rfcxml-mcp",
  "version": "0.6.51",
  "description": "RFC 文書の構造化理解 MCP server。RFCXML 経由でセクション・規範的要求事項 (MUST/SHOULD/MAY)・依存 RFC・準拠チェックリストを取得。",
  "author": {
    "name": "shuji-bonji",
    "email": "bonji@mikuro.jp",
    "url": "https://github.com/shuji-bonji"
  },
  "homepage": "https://github.com/shuji-bonji/rfcxml-mcp",
  "repository": "https://github.com/shuji-bonji/rfcxml-mcp",
  "license": "MIT",
  "keywords": [
    "rfc",
    "ietf",
    "rfcxml",
    "specification",
    "mcp",
    "mcp-server",
    "requirements"
  ],
  "mcpServers": {
    "rfcxml": {
      "command": "npx",
      "args": [
        "-y",
        "@shuji-bonji/rfcxml-mcp@latest"
      ]
    }
  }
}
